# Neon PostgreSQL Connection String Template
# Example: postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require

# Authentication & Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Application Environment & Database Seeding Controls
ENVIRONMENT=development
PORT=8000
ENABLE_SEED=false

