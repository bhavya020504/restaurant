# Vercel Frontend Environment Variables
# Set VITE_API_BASE_URL in your Vercel Dashboard -> Project Settings -> Environment Variables
# Point this to your Render backend API base URL (including /api/v1)
# Example: https://br-kitchen-backend.onrender.com/api/v1
VITE_API_BASE_URL=https://your-render-backend-name.onrender.com/api/v1
